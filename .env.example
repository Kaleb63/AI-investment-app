APP_ENV=development
DATABASE_URL=sqlite:///./investment_app.db
SECRET_KEY=replace-with-at-least-32-random-characters
PLAID_ENCRYPTION_KEY=replace-with-a-fernet-key

FINNHUB_API_KEY=
FINNHUB_MAX_CONCURRENCY=5
FINNHUB_MAX_RETRIES=3
